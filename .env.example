# Copie para .env e preencha apenas localmente. Nunca versione credenciais reais.

# Usada pelo SDK oficial TypeSafe/Jev no servidor.
TYPESAFE_API_KEY=

# Intervalo minimo entre avaliacoes contextuais. Valores menores aumentam chamadas/custo.
JEV_INTERVAL_SECONDS=0.75

# Pesos locais usados pela camada de percepcao.
CAMPUS_SENTINEL_MODEL=models/yolo26n-pose.pt
