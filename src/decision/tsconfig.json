{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../../tests/decision/**/*.ts"
  ]
}
